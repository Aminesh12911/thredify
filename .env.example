# Copy to .env.local for local development. Leave the Supabase values blank to run in DEMO MODE
# (seed data + browser-local storage; no account or database needed).

# --- Supabase (optional) -------------------------------------------------------------
# Project Settings -> API. The anon key is designed to be public: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste into client code.
# Used only by the order API route to write orders. Set it as a Vercel environment variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ----------------------------------------------------------------------------
# Public URL used for canonical links, the sitemap and Open Graph tags.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is blank.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
